 "unita": {
  "8272fe57": {
   "voce": "narratore",
   "testo": "La stazione di Acquaviva. I binari finiscono qui, mangiati dalla gramigna; un cartello arrugginito promette treni che non passano da anni. È da qui che parti, a piedi. In tasca hai l'ultimo biglietto arrivato da casa. Le lettere di prima le scriveva tua moglie, fitte, con le notizie del bambino in fondo; questo è in stampatello, senza firma, e dice una cosa sola: Non è il caso di tornare. Sei tornato lo stesso.",
   "parole": 73,
   "fonti": [
    {
     "riga": 8,
     "tipo": "descrizione",
     "parte": 0
    }
   ]
  },
  "30d5ba4a": {
   "voce": "servizio",
   "testo": "Esamina il biglietto per rileggerlo.",
   "parole": 5,
   "fonti": [
    {
     "riga": 8,
     "tipo": "descrizione",
     "parte": 1
    }
   ]
  },
  "1d131767": {
   "voce": "narratore",
   "testo": "A nord la piazza.",
   "parole": 4,
   "fonti": [
    {
     "riga": 8,
     "tipo": "descrizione",
     "parte": 2
    }
   ]
  },
  "09e2e44d": {
   "voce": "servizio",
   "testo": "Quando il corpo lo chiede: bevi per la sete, mangia per la fame; stato per vederti addosso.",
   "parole": 17,
   "fonti": [
    {
     "riga": 8,
     "tipo": "descrizione",
     "parte": 3
    }
   ]
  },
  "e0980dee": {
   "voce": "narratore",
   "testo": "La piazza del paese attorno a un pozzo asciutto. Persiane sbarrate, una fontana muta. Solo il bar, a est, tiene una luce accesa. A nord una casa aperta, a ovest il margine del paese e la strada. A sud la stazione.",
   "parole": 41,
   "fonti": [
    {
     "riga": 11,
     "tipo": "descrizione",
     "parte": 0
    }
   ]
  },
  "4f703cc2": {
   "voce": "narratore",
   "testo": "Un bar fermo agli ultimi avventori. Dietro il banco, Nunzio tiene in fila bottiglie vuote, le etichette in avanti.",
   "parole": 19,
   "fonti": [
    {
     "riga": 14,
     "tipo": "descrizione",
     "parte": 0
    }
   ]
  },
  "5fa89eb4": {
   "voce": "servizio",
   "testo": "Parla con Nunzio per barattare.",
   "parole": 5,
   "fonti": [
    {
     "riga": 14,
     "tipo": "descrizione",
     "parte": 1
    }
   ]
  },
  "8e192fb7": {
   "voce": "narratore",
   "testo": "Si torna a ovest.",
   "parole": 4,
   "fonti": [
    {
     "riga": 14,
     "tipo": "descrizione",
     "parte": 2
    }
   ]
  },
  "e012d45b": {
   "voce": "narratore",
   "testo": "Una casa lasciata in fretta: cassetti aperti, una foto storta alla parete. Marito, moglie, un bambino in braccio: gente di qui, che non conosci. Ti viene da raddrizzarla. Si torna a sud.",
   "parole": 32,
   "fonti": [
    {
     "riga": 17,
     "tipo": "descrizione",
     "parte": 0
    }
   ]
  },
  "1a350c2d": {
   "voce": "narratore",
   "testo": "Una casa lasciata in fretta: cassetti aperti, una foto alla parete, adesso dritta. Marito, moglie, un bambino in braccio: gente di qui, che non conosci. Si torna a sud.",
   "parole": 29,
   "fonti": [
    {
     "riga": 18,
     "tipo": "descrizione",
     "parte": 0
    }
   ]
  },
  "2a30dc35": {
   "voce": "narratore",
   "testo": "Dove finiscono le case comincia il bianco. La strada esce a ovest, nella piana che frigge sotto il sole. Si torna a est, in piazza.",
   "parole": 25,
   "fonti": [
    {
     "riga": 21,
     "tipo": "descrizione",
     "parte": 0
    }
   ]
  },
  "464a9fb8": {
   "voce": "narratore",
   "testo": "Su un mobile, una mappa piegata della provincia.",
   "parole": 8,
   "fonti": [
    {
     "riga": 32,
     "tipo": "posto",
     "parte": 0
    }
   ]
  },
  "01cdc9b9": {
   "voce": "narratore",
   "testo": "Una mappa della provincia, le strade segnate a penna. Acquamorta è all'altro capo, oltre le colline.",
   "parole": 16,
   "fonti": [
    {
     "riga": 33,
     "tipo": "descrizione",
     "parte": 0
    }
   ]
  },
  "25de9045": {
   "voce": "narratore",
   "testo": "In un cassetto rimasto aperto, un vecchio orologio da polso.",
   "parole": 10,
   "fonti": [
    {
     "riga": 38,
     "tipo": "posto",
     "parte": 0
    }
   ]
  },
  "f83a355b": {
   "voce": "narratore",
   "testo": "Un orologio da polso fermo, ma d'oro vero. Qualcuno te lo cambierebbe con qualcosa di più utile.",
   "parole": 17,
   "fonti": [
    {
     "riga": 39,
     "tipo": "descrizione",
     "parte": 0
    }
   ]
  },
  "120355d4": {
   "voce": "narratore",
   "testo": "Sul lavello, un coltello da cucina.",
   "parole": 6,
   "fonti": [
    {
     "riga": 44,
     "tipo": "posto",
     "parte": 0
    }
   ]
  },
  "be770d84": {
   "voce": "narratore",
   "testo": "Un coltello da cucina, la lama ancora buona. Meglio di niente, contro i denti.",
   "parole": 14,
   "fonti": [
    {
     "riga": 45,
     "tipo": "descrizione",
     "parte": 0
    }
   ]
  },
  "f22e7137": {
   "voce": "narratore",
   "testo": "Marito, moglie e un bambino in braccio, in posa davanti alla fontana della piazza, quando buttava ancora acqua. Una crepa attraversa il vetro in un angolo.",
   "parole": 26,
   "fonti": [
    {
     "riga": 51,
     "tipo": "descrizione",
     "parte": 0
    }
   ]
  },
  "feb88abe": {
   "voce": "narratore",
   "testo": "La raddrizzi con due dita. Il chiodo tiene. Per un momento la casa sembra soltanto chiusa, non lasciata.",
   "parole": 18,
   "fonti": [
    {
     "riga": 55,
     "tipo": "messaggio",
     "parte": 0
    }
   ]
  },
  "ad669051": {
   "voce": "narratore",
   "testo": "È dritta. Di più non puoi fare, per gente che non conosci.",
   "parole": 12,
   "fonti": [
    {
     "riga": 56,
     "tipo": "messaggio",
     "parte": 0
    }
   ]
  },
  "7d539698": {
   "voce": "narratore",
   "testo": "La lasci al suo chiodo. Non è roba tua, e non è roba da portare in viaggio.",
   "parole": 17,
   "fonti": [
    {
     "riga": 57,
     "tipo": "messaggio",
     "parte": 0
    }
   ]
  },
  "d9116f72": {
   "voce": "narratore",
   "testo": "Magro, la camicia stirata anche adesso che non viene più nessuno. Tiene aperto per testardaggine.",
   "parole": 15,
   "fonti": [
    {
     "riga": 62,
     "tipo": "descrizione",
     "parte": 0
    }
   ]
  },
  "a82f9fef": {
   "voce": "narratore",
   "testo": "Rimette il bicchiere al suo posto.",
   "parole": 6,
   "fonti": [
    {
     "riga": 67,
     "tipo": "dialogo",
     "parte": 0
    }
   ]
  },
